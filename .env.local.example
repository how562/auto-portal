# Optional: protect /admin routes and API (omit in local dev for open admin)
CMS_ADMIN_SECRET=

# Optional (off by default): Screenshot → CMS blueprint AI
# ENABLE_SCREENSHOT_BLUEPRINT_AI=true
# OPENAI_API_KEY=
# OPENAI_BLUEPRINT_MODEL=gpt-4o-mini

# Secured import endpoints (server-only — /api/import-homenet, /api/import-vauto)
IMPORT_SECRET=

# HomeNet DealerSend SFTP import (/api/import-homenet)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PATH=/path/on/sftp/server

# vAuto dedicated intake server on DigitalOcean (/api/import-vauto — intake only until parser ships)
# User vauto, path /feeds/vauto/incoming
VAUTO_SFTP_HOST=
VAUTO_SFTP_PORT=22
VAUTO_SFTP_USER=vauto
VAUTO_SFTP_PASSWORD=
VAUTO_SFTP_PATH=/feeds/vauto/incoming
# Optional JSON map of filename tokens → store UUIDs (multi-dealer SFTP folders)
# Example: {"cavender-toyota":"uuid-here","cavender_chevrolet":"uuid-here"}
HOMENET_STORE_FILE_MAP=
# Deprecated for multi-dealer imports — each file must resolve to a store via map, filename, or feed
HOMENET_DEFAULT_STORE_ID=

