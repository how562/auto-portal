# --- DEPRECATED (HomeNet rollback only; remove after every store is on vAuto) ---
# HomeNet DealerSend SFTP import (/api/import-homenet)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PATH=/path/on/sftp/server
# Optional JSON map of filename tokens → store UUIDs (multi-dealer SFTP folders)
# Example: {"cavender-toyota":"uuid-here","cavender_chevrolet":"uuid-here"}
HOMENET_STORE_FILE_MAP=
# Deprecated for multi-dealer imports — each file must resolve to a store via map, filename, or feed
HOMENET_DEFAULT_STORE_ID=
# --- end deprecated HomeNet vars ---

# vAuto dedicated SFTP on DigitalOcean (/api/import-vauto — portal-owned importer)
# GET = SFTP production import; POST { csvContent, fileName?, storeId? } = inline test
# User vauto, path /feeds/vauto/incoming (confirm with ops)
VAUTO_SFTP_HOST=
VAUTO_SFTP_PORT=22
VAUTO_SFTP_USER=vauto
VAUTO_SFTP_PASSWORD=
VAUTO_SFTP_PATH=/feeds/vauto/incoming
# Optional JSON map of filename / DealerId tokens → store UUIDs
# Example: {"cavenderbuickgmcnorth":"uuid-here","BGMCN":"uuid-here"}
VAUTO_STORE_FILE_MAP=
# Edge Function inventory-import (optional): when set, Edge proxies to this host's /api/import-vauto
# PORTAL_IMPORT_URL=https://your-portal-host

